{
  "name": "tipwell",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "auth:generate": "auth generate --config src/lib/auth-schema-config.ts --adapter drizzle --dialect postgresql --output src/db/auth-schema.ts --yes",
    "db:generate": "auth generate --config src/lib/auth-schema-config.ts --adapter drizzle --dialect postgresql --output src/db/auth-schema.ts --yes && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.12",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@neondatabase/serverless": "1.2.0",
    "better-auth": "1.7.12",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.12",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
