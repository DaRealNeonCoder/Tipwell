# Neon pooled connection string, including sslmode=require when supplied by Neon.
DATABASE_URL=
# At least 32 high-entropy characters. `pnpm dlx auth secret` can generate one.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional until Google sign-in is enabled; provide both values together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
